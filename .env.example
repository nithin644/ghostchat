# ============================================================================
# GhostChat — environment template
# Copy to .env and replace every CHANGE_ME value before running anything.
# Generate secrets with:  openssl rand -base64 48
# ============================================================================

NODE_ENV=development

# --- Datastores -------------------------------------------------------------
POSTGRES_USER=ghostchat
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=ghostchat
DATABASE_URL=postgresql://ghostchat:CHANGE_ME_postgres_password@127.0.0.1:5432/ghostchat?schema=public&sslmode=prefer

REDIS_URL=redis://:CHANGE_ME_redis_password@127.0.0.1:6379
REDIS_PASSWORD=CHANGE_ME_redis_password

# --- Application secrets ----------------------------------------------------
# Peppers the server-side hash of access-key handles (BLAKE2b key).
SESSION_SECRET=CHANGE_ME_48_bytes_base64
# Key used by the sealed-sender abuse-token MAC (see README threat model).
SEALED_SENDER_PEPPER=CHANGE_ME_48_bytes_base64
# One-shot bootstrap credential for the CLI that mints the first admin key.
# Remove from the environment after the first admin key is claimed.
ADMIN_BOOTSTRAP_KEY=CHANGE_ME_48_bytes_base64

# --- HTTP -------------------------------------------------------------------
PORT=4000
CORS_ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
COOKIE_DOMAIN=
# Set to 1 when you run behind TLS (mandatory in production).
COOKIE_SECURE=false

# --- Sessions / rate limits -------------------------------------------------
SESSION_TTL_SECONDS=43200
SESSION_IDLE_SECONDS=1800
RATE_LIMIT_DISABLED=false

# --- Media storage ----------------------------------------------------------
# local  = blobs on the API's own disk (no external service, no container)
# s3     = presigned uploads to any S3-compatible endpoint (AWS, Ceph RGW,
#          Garage, SeaweedFS, ...). Fill in the S3_* values if you pick this.
MEDIA_DRIVER=local
MEDIA_DIR=./.ghostchat-state/media

# The server only ever stores client-side-encrypted blobs.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=ghostchat-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
MEDIA_MAX_BYTES=26214400

# --- WebRTC -----------------------------------------------------------------
# STUN/TURN handed to clients. TURN credentials are time-limited (RFC 8489
# "TURN REST API" style) and minted per session by CallService.
TURN_URLS=turn:turn.localhost:3478?transport=udp,turn:turn.localhost:3478?transport=tcp
TURN_SHARED_SECRET=CHANGE_ME_coturn_static_auth_secret
TURN_CREDENTIAL_TTL=3600

# SFU: enable only when a mediasoup-capable media node is deployed.
MEDIASOUP_ENABLED=false
MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=40100

# --- Frontend ---------------------------------------------------------------
# Dev: absolute, so the browser talks to the API directly and CORS applies.
# Onion/prod: set to "/api" and let the single-origin proxy route it.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_WS_URL=
NEXT_PUBLIC_TURN_URLS=turn:turn.localhost:3478?transport=udp
NEXT_PUBLIC_SFU_ENABLED=false
