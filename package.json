{
  "name": "ghostchat",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@12.0.2",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "npm run prisma:generate -w @ghostchat/api",
    "db:migrate": "npm run prisma:migrate -w @ghostchat/api",
    "db:deploy": "npm run prisma:deploy -w @ghostchat/api",
    "seed:admin": "npm run seed:admin -w @ghostchat/api",
    "dev:api": "npm run dev -w @ghostchat/api",
    "dev:web": "npm run dev -w @ghostchat/web"
  },
  "devDependencies": {
    "@types/http-proxy": "^1.17.15",
    "http-proxy": "^1.18.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
